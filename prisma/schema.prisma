  domicilio            String
  tipoBienContratado   String
  montoReclamado       Decimal?  @db.Decimal(10, 2)
  descripcionBien      String    @db.Text
  tipoReclamacion      String
  detalleReclamacion   String    @db.Text
  pedidoConsumidor     String    @db.Text
  estadoAtencion       String    @default("PENDIENTE")
  respuestaInstitucion String?   @db.Text
